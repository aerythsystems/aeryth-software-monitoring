# Lokal: salin ke .env. Vercel: Settings > Environment Variables.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ganti-dengan-password-kuat
SESSION_SECRET=ganti-dengan-string-acak-minimal-32-karakter
# Token untuk aplikasi non-web (min 16 karakter)
HEARTBEAT_TOKEN=ganti-dengan-token-acak-minimal-16-karakter
# Opsional tapi disarankan di Vercel (Upstash Redis free tier) agar heartbeat & log permanen
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Telegram bot (BotFather) + cron
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=ganti-dengan-string-acak
CRON_SECRET=ganti-dengan-token-acak-minimal-16-karakter
